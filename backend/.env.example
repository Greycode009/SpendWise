# ---- Required -------------------------------------------------------------
# PostgreSQL connection string
DATABASE_URL="postgresql://spendwise:spendwise@localhost:5432/spendwise?schema=public"

# Secret used to sign access tokens. In production use a long random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-me-with-a-long-random-string-of-at-least-32-chars"

# ---- Optional -------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Access token lifetime (jsonwebtoken format) and refresh token lifetime in days
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# Only needed when the frontend is hosted on a DIFFERENT domain than the API,
# e.g. https://spendwise.vercel.app  (comma-separate multiple origins)
CORS_ORIGIN=

# Number of reverse proxies in front of the app (1 on Render, Railway, Fly…)
TRUST_PROXY=0

# Serve the built frontend (frontend/dist) from this server. Set to false when
# the frontend is deployed separately.
SERVE_CLIENT=true
